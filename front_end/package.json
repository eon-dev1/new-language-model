{
  "name": "new-language-model",
  "version": "1.2.0",
  "description": "New Language Model",
  "main": "dist/main/main.js",
  "author": "Eon Dev",
  "license": "MIT",
  "scripts": {
    "dev:renderer": "vite",
    "dev:main": "webpack --mode development --watch",
    "build:renderer": "vite build",
    "build:main": "webpack --mode production",
    "build": "npm run build:main && npm run build:renderer",
    "start": "node scripts/launch-electron.js",
    "prepare:mongo": "node scripts/download-mongo-binaries.js",
    "predev": "node scripts/download-mongo-binaries.js",
    "setup": "node scripts/setup.js",
    "dev": "concurrently --kill-others --success first --names \"main,renderer,electron\" \"npm run dev:main\" \"npm run dev:renderer\" \"node scripts/wait-file.js dist/main/main.js && node scripts/launch-electron.js\"",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write .",
    "test": "vitest run && vitest run --config vitest.renderer.config.ts",
    "test:main": "vitest --config vitest.config.ts",
    "test:renderer": "vitest --config vitest.renderer.config.ts",
    "test:coverage": "vitest run --coverage && vitest run --config vitest.renderer.config.ts --coverage"
  },
  "dependencies": {
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@mui/icons-material": "5.18.0",
    "@mui/material": "5.18.0",
    "electron": "43.8.5",
    "framer-motion": "10.18.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.1",
    "@testing-library/user-event": "14.6.1",
    "@vitejs/plugin-react": "4.6.0",
    "@vitest/coverage-v8": "4.1.12",
    "concurrently": "10.0.6",
    "eslint": "8.57.1",
    "jsdom": "27.4.0",
    "license-checker": "25.0.1",
    "prettier": "3.6.2",
    "ts-loader": "9.5.2",
    "typescript": "5.8.3",
    "typescript-language-server": "5.3.0",
    "vite": "7.3.7",
    "vitest": "4.1.12",
    "webpack": "5.105.4",
    "webpack-cli": "5.1.4"
  }
}
